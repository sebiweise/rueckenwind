{
	"name": "rueckenwind",
	"version": "0.0.0",
	"private": true,
	"description": "Begleit-App (PWA) für die Suche nach einem ambulanten Psychotherapieplatz in Deutschland",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/sebiweise/rueckenwind.git"
	},
	"type": "module",
	"engines": {
		"node": ">=22.12"
	},
	"scripts": {
		"dev": "next dev",
		"build": "next build",
		"preview": "node scripts/preview.mjs",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"check": "tsc --noEmit",
		"test": "vitest --run",
		"test:unit": "vitest",
		"test:e2e": "playwright test"
	},
	"dependencies": {
		"next": "^16.4.0",
		"react": "^19.3.0",
		"react-dom": "^19.3.0"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.13.0",
		"@playwright/test": "^1.64.0",
		"@types/node": "^22.20.5",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"eslint": "^9.39.5",
		"eslint-config-next": "^16.4.0",
		"eslint-config-prettier": "^10.1.8",
		"prettier": "^3.9.9",
		"typescript": "^5.9.3",
		"vitest": "^5.0.3"
	}
}
