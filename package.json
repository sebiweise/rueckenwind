{
	"name": "rueckenwind",
	"version": "0.1.0",
	"private": true,
	"description": "Begleit-App (PWA) für die Suche nach einem ambulanten Psychotherapieplatz in Deutschland",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/sebiweise/rueckenwind.git"
	},
	"type": "module",
	"engines": {
		"node": ">=22.18"
	},
	"scripts": {
		"dev": "next dev",
		"build": "next build",
		"postbuild": "node scripts/postbuild.mjs",
		"start": "node scripts/preview.mjs",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"check": "tsc --noEmit",
		"test": "vitest --run",
		"test:unit": "vitest",
		"test:coverage": "vitest --run --coverage",
		"test:e2e": "playwright test"
	},
	"dependencies": {
		"@fontsource-variable/nunito": "^5.3.0",
		"dexie": "^4.4.7",
		"dexie-react-hooks": "^4.4.0",
		"marked": "^18.1.2",
		"next": "^16.4.3",
		"pdfmake": "^0.3.13",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"yaml": "^2.9.1",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.14.0",
		"@playwright/test": "^1.64.1",
		"@serwist/cli": "^9.5.13",
		"@serwist/next": "^9.5.13",
		"@types/node": "^26.6.5",
		"@types/pdfmake": "^0.3.3",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitest/coverage-v8": "^5.0.5",
		"esbuild": "^0.28.2",
		"eslint": "^9.39.5",
		"eslint-config-next": "^16.4.3",
		"eslint-config-prettier": "^10.1.8",
		"fake-indexeddb": "^6.2.6",
		"pdfjs-dist": "^6.4.299",
		"prettier": "^3.9.10",
		"serwist": "^9.5.13",
		"typescript": "^5.9.3",
		"vitest": "^5.0.3"
	}
}
